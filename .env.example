# Copy to .env (or run scripts/setup.ps1, which generates strong random values). Never commit .env.
REFORGE_ADMIN_TOKEN=replace-with-a-long-random-string
REFORGE_VIEWER_TOKEN=
REFORGE_AGENT_SECRET=replace-with-another-long-random-string
# simulate = evaluate only | approval = click Approve in the dashboard | auto = execute automatically
REFORGE_RECOVERY_MODE=approval
